{
  "private": true,
  "name": "vscode-analog",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/analogjs/language-tools.git",
    "directory": "packages/vscode"
  },
  "categories": [
    "Programming Languages"
  ],
  "displayName": "AnalogJS Language Features",
  "description": "AnalogJS Language Features",
  "author": "Brandon Roberts",
  "publisher": "AnalogJS",
  "engines": {
    "vscode": "^1.82.0"
  },
  "icon": "images/analog.png",
  "activationEvents": [
    "onLanguage:html"
  ],
  "main": "./dist/client.js",
  "contributes": {},
  "scripts": {
    "build": "node scripts/build -- --minify",
    "watch": "npm run build -- --watch",
    "pack": "npm run build && vsce package",
    "release": "npm run build && vsce publish --pre-release"
  },
  "devDependencies": {
    "@analogjs/language-server": "workspace:*",
    "@types/vscode": "^1.82.0",
    "@volar/language-server": "~2.4.28",
    "@volar/vscode": "~2.4.28",
    "esbuild": "latest",
    "vsce": "latest",
    "vscode-languageclient": "^9.0.1"
  }
}
